// Court Case Management System — domain schema
// Migrations: pnpm --filter @court-ccms/server prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REGISTRAR
  JUDGE
  LAWYER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CaseType {
  CIVIL
  CRIMINAL
  REVENUE
  ADMIRALTY
  OTHER
}

enum CaseStatus {
  DRAFT
  PENDING_APPROVAL
  REJECTED
  ACTIVE
  PART_HEARD
  ADJOURNED
  CLOSED
}

enum DocumentCategory {
  PLEADING
  EVIDENCE
  ORDER
  NOTE
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

enum OcrStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  NOT_APPLICABLE
}

enum HearingStatus {
  SCHEDULED
  COMPLETED
  ADJOURNED
  CANCELLED
}

enum RulingStatus {
  DRAFT
  PUBLISHED
}

enum CaseEventType {
  FILED
  APPROVED
  REJECTED
  JUDGE_ASSIGNED
  HEARING_SCHEDULED
  ADJOURNED
  DOCUMENT_ADDED
  RULING_PUBLISHED
  CLOSED
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PartyRole {
  CLAIMANT
  DEFENDANT
  APPLICANT
  RESPONDENT
  WITNESS
}

enum ConsentPurpose {
  HEARING_NOTIFICATIONS
  CASE_UPDATE_NOTIFICATIONS
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  role             Role
  firstName        String
  lastName         String
  phoneNumber      String? // stored E.164
  isActive                Boolean   @default(true)
  failedLoginCount        Int       @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  passwordResetTokenHash   String?
  passwordResetExpiresAt  DateTime?
  passwordResetUsedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  lawyerProfile     LawyerProfile?
  refreshTokens     RefreshToken[]
  scheduledHearings Hearing[]       @relation("HearingScheduledBy")
  verifiedLawyers   LawyerProfile[] @relation("LawyerVerifiedBy")
  uploadedDocuments Document[]      @relation("DocumentUploadedBy")
  consentRecords    ConsentRecord[]
  casesFiled        Case[]          @relation("CaseFiledBy")
  casesJudged       Case[]          @relation("CaseAssignedJudge")
  casesRegistered   Case[]          @relation("CaseAssignedRegistrar")
  rulings           Ruling[]
  caseEvents        CaseEvent[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([passwordResetTokenHash])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model LawyerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  nbaEnrolmentNumber String             @unique
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("LawyerVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([verifiedById])
  @@map("lawyer_profiles")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Division {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  courts    Court[]
  cases     Case[]
  sequences CaseSequence[]

  @@map("divisions")
}

model Court {
  id         String   @id @default(cuid())
  divisionId String
  name       String
  number     String
  createdAt  DateTime @default(now())

  division Division  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  cases    Case[]
  hearings Hearing[]

  @@unique([divisionId, name])
  @@index([divisionId])
  @@map("courts")
}

model CaseSequence {
  id         String @id @default(cuid())
  divisionId String
  typeCode   String
  year       Int
  lastValue  Int    @default(0)

  division Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)

  @@unique([divisionId, typeCode, year])
  @@index([divisionId, typeCode, year])
  @@map("case_sequences")
}

model Case {
  id                  String     @id @default(cuid())
  caseNumber          String?    @unique
  title               String
  summary             String?
  reliefSought        String?
  caseType            CaseType
  suitTypeCode        String
  status              CaseStatus @default(DRAFT)
  isRestricted        Boolean    @default(false)
  rejectionReason     String?
  divisionId          String
  courtId             String?
  filedById           String
  assignedJudgeId     String?
  assignedRegistrarId String?
  approvedAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  division          Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  court             Court?   @relation(fields: [courtId], references: [id], onDelete: Restrict)
  filedBy           User     @relation("CaseFiledBy", fields: [filedById], references: [id], onDelete: Restrict)
  assignedJudge     User?    @relation("CaseAssignedJudge", fields: [assignedJudgeId], references: [id], onDelete: SetNull)
  assignedRegistrar User?    @relation("CaseAssignedRegistrar", fields: [assignedRegistrarId], references: [id], onDelete: SetNull)

  parties       Party[]
  documents     Document[]
  hearings      Hearing[]
  rulings       Ruling[]
  events        CaseEvent[]
  notifications Notification[]

  @@index([divisionId])
  @@index([courtId])
  @@index([filedById])
  @@index([assignedJudgeId])
  @@index([assignedRegistrarId])
  @@index([status])
  @@index([caseNumber])
  @@index([createdAt])
  @@map("cases")
}

model Party {
  id           String    @id @default(cuid())
  caseId       String
  name         String
  role         PartyRole
  contactInfo  Json? // PII payload
  counselName  String?
  isIndividual Boolean   @default(true)
  createdAt    DateTime  @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([role])
  @@map("parties")
}

model Document {
  id              String           @id @default(cuid())
  caseId          String
  documentGroupId String
  version         Int              @default(1)
  category        DocumentCategory
  fileName        String
  objectKey       String
  fileSize        BigInt
  mimeType        String
  checksumSha256  String
  scanStatus      ScanStatus       @default(PENDING)
  ocrStatus       OcrStatus        @default(PENDING)
  ocrText         String?
  uploadedById    String
  createdAt       DateTime         @default(now())

  case       Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([documentGroupId])
  @@index([uploadedById])
  @@map("documents")
}

model Hearing {
  id            String        @id @default(cuid())
  caseId        String
  courtId       String
  scheduledAt   DateTime
  purpose       String?
  status        HearingStatus @default(SCHEDULED)
  notes         String?
  scheduledById String
  createdAt     DateTime      @default(now())

  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Restrict)
  scheduler User     @relation("HearingScheduledBy", fields: [scheduledById], references: [id], onDelete: Restrict)
  rulings   Ruling[]

  @@unique([courtId, scheduledAt])
  @@index([caseId])
  @@index([courtId])
  @@index([scheduledAt])
  @@map("hearings")
}

model Ruling {
  id          String       @id @default(cuid())
  caseId      String
  hearingId   String?
  judgeId     String
  title       String
  body        String
  // Structured citations — array of { kind, citation, note? }. Kept as JSON
  // because SQLite has no native array type and the shape is presentation-only.
  citations   Json?
  status      RulingStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  case    Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  hearing Hearing? @relation(fields: [hearingId], references: [id], onDelete: SetNull)
  judge   User     @relation(fields: [judgeId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([hearingId])
  @@index([judgeId])
  @@index([status])
  @@map("rulings")
}

model CaseEvent {
  id        String        @id @default(cuid())
  caseId    String
  type      CaseEventType
  actorId   String?
  metadata  Json?
  createdAt DateTime      @default(now())

  case  Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
  @@map("case_events")
}

model Notification {
  id                String              @id @default(cuid())
  recipientId       String
  caseId            String?
  channel           NotificationChannel
  template          String
  message           String
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  attempts          Int                 @default(0)
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  recipient User  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  case      Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([caseId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model ConsentRecord {
  id          String              @id @default(cuid())
  contactId   String?
  userId      String?
  purpose     ConsentPurpose
  channel     NotificationChannel
  grantedAt   DateTime            @default(now())
  withdrawnAt DateTime?
  source      String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contactId])
  @@map("consent_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  requestId String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
