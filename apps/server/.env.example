NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://ccms:ccms@localhost:5432/ccms?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=ccms-documents

JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d
REQUEST_ID_HEADER=x-request-id

MINIO_CONSOLE_URL=http://localhost:9001

# Seed passwords (only used by `prisma db seed` — never set in production with NODE_ENV=production)
ADMIN_PASSWORD=change-me-admin-12
