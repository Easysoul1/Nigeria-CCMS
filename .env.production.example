# ---------------------------------------------------------------------------
# Production environment
#
# Turso is the database. Local dev uses file:./dev.db; production uses
# TURSO_DATABASE_URL + TURSO_AUTH_TOKEN. Leave DATABASE_URL unset in prod.
# ---------------------------------------------------------------------------

NODE_ENV=production

# ---------- Turso (production only) ----------
# turso db show <db-name> --url
TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
# turso db tokens create <db-name>
TURSO_AUTH_TOKEN=CHANGE_ME

# ---------- Auth ----------
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_64

# Must match the public frontend origin exactly (used by the CSRF guard).
CORS_ORIGINS=https://ccms.example.com

# Leave at 0 except on first boot of an empty database.
ALLOW_SEED=0

# ---------- Optional ----------
# MINIO_ENDPOINT=minio
# MINIO_USER=ccmsminio
# MINIO_PASSWORD=CHANGE_ME
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_BUCKET=ccms-documents
# REDIS_HOST=redis
# REDIS_PORT=6379
# LOG_LEVEL=info
